# Optional: enable live LLM comment drafting (Problem 1) and answer phrasing (Problem 2).
# Without this key, both problems use deterministic local fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Problem 1 webhook delivery: "log" (default demo stub) or "http" (real POST).
AGENT_SOCIAL_WEBHOOK_MODE=log

# Problem 2 privilege strategy: A (scoped sudo), B (helper daemon), C (non-root).
# Leave unset for auto (sudo if present, else C).
HARDWARE_QA_PRIVILEGE=
# HARDWARE_QA_HELPER_SOCK=/run/hardware-qa/helper.sock
